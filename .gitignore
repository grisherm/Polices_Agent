# Archivos y carpetas que no se deben subir

# Entorno virtual local
.venv/
venv/
env/

# Variables sensibles
.env
.env.*
!.env.example



# Índice antiguo (ya no se usa; se mantiene el nombre por compatibilidad)
faiss_index/

# faiss_indexv2/ SÍ se versiona a propósito: se construye localmente y se
# commitea para que el despliegue (ej. Render free tier) solo tenga que
# cargarlo, no reconstruirlo. Reconstruirlo en el servidor carga la
# librería transformers y excede los 512 MB de RAM del plan gratuito.


# Resultados temporales de ejecución
.ipynb_checkpoints/
*.log

# Dependencias instaladas localmente por error
node_modules/


# Caché generada por Python
__pycache__/
*.py[cod]
.pytest_cache/

# Configuración local de VS Code
.vscode/